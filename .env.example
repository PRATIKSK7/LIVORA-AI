# LIVORA AI — Environment Variables Configuration Template
# Copy this file to .env or web/.env before configuring local overrides.
# Note: Never commit secrets, API keys, or credentials to version control.

# ==============================================================================
# 1. Routing Engine Configuration (Backend)
# ==============================================================================
# Supported providers: "osrm" (default, free OpenStreetMap routing), "graphhopper", "openrouteservice"
ROUTING_PROVIDER=osrm

# OSRM Public or Self-Hosted Endpoint
OSRM_BASE_URL=http://router.project-osrm.org

# Optional Third-Party Routing Providers (Leave blank to use default OSRM)
GRAPHHOPPER_API_KEY=
OPENROUTESERVICE_API_KEY=

# Local SQLite Cache Path for Pedestrian Routes & Isochrones
ROUTE_CACHE_DB=data/cache/routes.db

# ==============================================================================
# 2. Frontend Configuration (Vite)
# ==============================================================================
# Backend API Base URL (Default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Optional Google Maps Platform API Key
# LIVORA AI's primary 3D Digital Twin runs completely FREE on Three.js and OpenStreetMap.
# Google Maps API key is ONLY required if explicitly enabling experimental CesiumJS Google Photorealistic 3D Tiles.
VITE_GOOGLE_MAPS_API_KEY=
